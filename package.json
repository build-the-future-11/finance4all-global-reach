{
  "name": "financemeta-member-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/verify-release-toolchain.mjs",
    "build": "npm run typecheck && node scripts/validate-public-env.mjs && vite build && node scripts/write-release-revision.mjs",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "validate:env": "node scripts/validate-public-env.mjs",
    "preview": "vite preview",
    "pretest": "node --test tests/release-toolchain.test.mjs && node scripts/verify-release-toolchain.mjs",
    "test": "vitest run && node --test tests/database-target.test.mjs tests/release-revision.test.mjs tests/runtime-equivalence.test.mjs tests/security-headers.test.mjs tests/workflow-supply-chain.test.mjs tests/migration-ledger.test.mjs tests/rls-certification.test.mjs tests/verify-production.test.mjs tests/verify-production-cleanup.test.mjs",
    "release:check": "npm test && npm run lint && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:credentialed": "playwright test --config=playwright.credentialed.config.ts",
    "production:verify": "node scripts/verify-production.mjs",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.117.0",
    "@tanstack/react-query": "^5.103.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^15.15.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.28",
    "storybook": "^10.6.0",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
