# Required for local development and production (copy to .env)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-jwt-here

# Optional — publishable keys do not replace the anon JWT for auth (see src/lib/supabase.ts)
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# NEVER put the Supabase service_role / secret key in frontend env vars.

# Optional — live business headlines on Debriefed (exposed in client bundle if set; prefer Supabase-curated news)
# VITE_NEWSAPI_KEY=your-newsapi-key

# Required in production — canonical site URL for OAuth redirects
# VITE_APP_URL=https://your-project.vercel.app
