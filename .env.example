# Required for local development and production (copy to .env)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-jwt-here

# NEVER put the Supabase service_role / secret key in frontend env vars.

# Required in production — canonical site URL for OAuth redirects
VITE_APP_URL=https://your-project.vercel.app
