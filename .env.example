# Vite requires the VITE_ prefix (NOT NEXT_PUBLIC_). Copy to .env and fill in values.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
VITE_AUTH_REDIRECT_ORIGIN=https://finance4all-global-reach.vercel.app

# NEVER put the Supabase service_role / secret key in frontend env vars.
