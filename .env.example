# Required for local development and production (copy to .env and fill locally)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon-jwt-only...

# Keep privileged backend credentials out of frontend env vars.
# Never set SUPABASE_SERVICE_ROLE_KEY, sb_secret_*, DIGEST_CRON_SECRET, or RESEND_API_KEY here.

# Local: http://localhost:8080
# Production (Vercel): https://your-canonical-domain (must be https://)
VITE_APP_URL=http://localhost:8080
